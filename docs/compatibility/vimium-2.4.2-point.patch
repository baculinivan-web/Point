--- a/background_scripts/main.js
+++ b/background_scripts/main.js
@@ -84,5 +84,15 @@
 // Re-check whether Vimium is enabled for a frame when the URL changes without a reload.
 // There's no reliable way to detect when the URL has changed in the content script, so we
 // have to use the webNavigation API in our background script.
-chrome.webNavigation.onHistoryStateUpdated.addListener(onURLChange); // history.pushState.
-chrome.webNavigation.onReferenceFragmentUpdated.addListener(onURLChange); // Hash changed.
+// Point/WebKit does not expose these two webNavigation events. Keep the native
+// events where available; use top-frame tab URL updates on Point instead.
+if (chrome.webNavigation.onHistoryStateUpdated) {
+  chrome.webNavigation.onHistoryStateUpdated.addListener(onURLChange);
+} else {
+  chrome.tabs.onUpdated.addListener((tabId, changeInfo) => {
+    if (changeInfo.url) onURLChange({ tabId, frameId: 0 });
+  });
+}
+if (chrome.webNavigation.onReferenceFragmentUpdated) {
+  chrome.webNavigation.onReferenceFragmentUpdated.addListener(onURLChange);
+}
