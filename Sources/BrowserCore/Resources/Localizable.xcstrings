      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It searches the web, reads and screenshots pages, runs Python, files your tabs into folders, and remembers what matters between conversations. Attach images or files, and answers come back with tables and formatting."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он ищет в интернете, читает страницы и делает их снимки, выполняет Python, раскладывает вкладки по папкам и помнит важное между диалогами. Можно прикреплять изображения и файлы, а ответы приходят с таблицами и форматированием."
          }
        }
      }
    },
