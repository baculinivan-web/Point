          }
        }
      }
    },
    "onboarding_assistant_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press ⇧⌘A to open it. It sees the page you are reading, searches the web, and opens tabs for you. Connect a provider now or skip and do it later in Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте его по ⇧⌘A. Он видит открытую страницу, ищет в интернете и открывает вкладки за вас. Подключите провайдера сейчас или пропустите и сделайте это позже в настройках."
          }
        }
      }
    },
    "onboarding_assistant_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat, right beside the page"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат прямо рядом со страницей"
          }
        }
      }
    },
    "onboarding_browser_use_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the agent control and it can browse through a site quietly: search, type, press Enter, choose options, and add items to a cart without narrating every step. Point still asks before consequential actions like ordering, paying, sending, publishing, or deleting."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передайте агенту управление, и он сможет спокойно пройти по сайту: искать, печатать, нажимать Enter, выбирать опции и добавлять товары в корзину без комментария каждого шага. Point всё ещё спросит перед важными действиями: заказом, оплатой, отправкой, публикацией или удалением."
          }
        }
      }
    },
    "onboarding_browser_use_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser Use works in the page"
          }
        },
        "ru": {
